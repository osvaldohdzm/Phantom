run_restore() {
  local archive="${1:-}"
  if [[ -z "$archive" ]]; then
    echo "Error: Especifica la ruta del archivo de backup (.tar.gz) a restaurar." >&2
    echo "Uso: ./phantom restore <ruta_al_backup.tar.gz>" >&2
    exit 1
  fi
  if [[ ! -f "$archive" ]]; then
    echo "Error: El archivo de backup no existe: $archive" >&2
    exit 1
  fi
  
  phantom_require_compose
  
  local temp_dir
  temp_dir=$(mktemp -d -t phantom_restore_XXXXXX)
  echo "[*] Extrayendo backup en directorio temporal..."
  tar -xzf "$archive" -C "$temp_dir"
  
  local src_dir
  src_dir=$(find "$temp_dir" -mindepth 1 -maxdepth 1 -type d | head -n 1)
  if [[ -z "$src_dir" ]]; then
    echo "[!] Backup corrupto o vacío." >&2
    rm -rf "$temp_dir"
    exit 1
  fi
  
  local db_user="${POSTGRES_USER:-phantom}"
  local db_name="${POSTGRES_DB:-katana_security_db}"
  
  if [[ -f "$src_dir/database.sql" ]]; then
    echo "[*] Restaurando base de datos PostgreSQL..."
    phantom_compose exec -T postgres psql -U "$db_user" -d postgres -c "DROP DATABASE IF EXISTS $db_name;" >/dev/null
    phantom_compose exec -T postgres psql -U "$db_user" -d postgres -c "CREATE DATABASE $db_name;" >/dev/null
    if ! phantom_compose exec -T postgres psql -U "$db_user" -d "$db_name" < "$src_dir/database.sql" >/dev/null; then
      echo "[!] Error al restaurar la base de datos." >&2
      rm -rf "$temp_dir"
      exit 1
    fi
    echo "[+] Base de datos restaurada."
  fi
  
  if [[ -f "$src_dir/storage.tar.gz" ]]; then
    echo "[*] Restaurando almacenamiento del API..."
    phantom_compose exec -T api tar -xzf - -C /app/backend < "$src_dir/storage.tar.gz" || {
      echo "[!] Advertencia: Fallo al restaurar almacenamiento." >&2
    }
    echo "[+] Almacenamiento restaurado."
  fi
  
  rm -rf "$temp_dir"
  echo "[+] Restauración completa con éxito."
}

run_release() {
  local sub="${1:-}"
  case "$sub" in
    tag)
      local tag="${2:-}"
      if [[ -z "$tag" ]]; then
        echo "Error: Especifica la etiqueta de la versión (ej. v0.4.0)." >&2
        exit 1
      fi
      echo "[*] Creando tag Git local y remoto: $tag..."
      git tag -a "$tag" -m "Release $tag"
      git push origin "$tag"
      echo "[+] Tag $tag empujado a origin."
      ;;
    *)
      echo "=== Phantom Release Manager ==="
      echo "Versión actual de Git: $(git describe --tags --always 2>/dev/null || echo "sin tags")"
      echo ""
      echo "Uso:"
      echo "  ./phantom release tag <versión>   Crea un tag git de versión y lo publica."
      echo ""
      echo "Procedimiento de Release recomendado:"
      echo "  1. Ejecuta tests y doctor: ./phantom doctor"
      echo "  2. Actualiza CHANGELOG.md"
      echo "  3. Crea el tag git de release: ./phantom release tag vX.Y.Z"
      ;;
  esac
}

