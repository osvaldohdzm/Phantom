run_help() {
  cat <<EOF
Phantom CLI Operativo — Portal de Control Unificado

Uso:
  ./phantom <namespace> <subcomando> [ambiente] [opciones]

Namespaces Disponibles:
  local     Operaciones nativas locales en el host.
  docker    Operaciones del stack basado en contenedores Docker/Podman.
  cluster   Operaciones sobre entornos Kubernetes.
  docs      Visualización y generación de documentación técnica interactiva.
  plugin    Gestión del ciclo de vida de los plugins de la plataforma.
  doctor    Diagnósticos y verificaciones del entorno y dependencias.
  backup    Crear snapshots de la base de datos y almacenamiento.
  restore   Restaurar snapshots de base de datos y almacenamiento.
  migrate   Ejecutar migraciones de base de datos locales al contenedor.
  release   Herramientas para gestión de tags y versiones de Git.
  update    Actualizar paquetes de desarrollo y dependencias.
  version   Mostrar la versión actual de la CLI.

Comandos por Namespace:

  [local]
    start [dev|qa|prod]   Iniciar entorno nativo local en background.
    stop                  Detener procesos locales activos.
    restart               Reiniciar procesos locales activos.
    status                Ver estado de los procesos locales y puertos.
    dev                   Ejecutar servidor en primer plano con HTTPS + hot-reload.
    prod                  Ejecutar servidor en primer plano con configuraciones de producción.
    install               Instalar dependencias de Python y Node.js en el host.
    uninstall             Remover directorios de dependencias locales.
    clean                 Limpiar archivos temporales y builds.
    debug                 Arrancar servidor local en depuración ultra-verbose.
    sbom                  Generar reporte SBOM de la cadena de suministro.
    passwd                Cambiar credenciales administrativas de Phantom.

  [docker]
    build                 Construir imágenes Docker para todos los servicios.
    start                 Iniciar stack de Docker Compose en background.
    stop                  Detener y remover contenedores del stack.
    restart               Reiniciar contenedores del stack.
    status                Listar estado actual de contenedores de Docker.
    logs [servicio]       Ver logs de contenedores de Docker (ej: web, api).
    fix                   Validar y corregir configuraciones de red y host.

  [cluster]
    deploy                Generar manifiestos y desplegar en Kubernetes.
    destroy               Remover namespaces y servicios del cluster.

  [docs]
    generate              Compilar y actualizar el índice README de la documentación.
    serve                 Levantar portal Docsify local (http://localhost:8080).

  [plugin]
    list                  Listar plugins instalados y del core.
    install <plugin>      Instalar un plugin externo.

Ejemplos:
  ./phantom local start dev
  ./phantom docker start
  ./phantom doctor
  ./phantom docs serve
EOF
}

# Main Command Dispatcher
case "$NAMESPACE" in
  local)
    case "${SUB_CMD:-}" in
      start)
        if [[ "$ENV" == "dev" || "$ENV" == "qa" || "$ENV" == "prod" ]]; then
          start_env "$ENV"
        else
          echo "Error: local start requiere especificar el ambiente: dev, qa o prod." >&2
          exit 1
        fi
        ;;
      stop)
        if [[ "$ENV" == "dev" || "$ENV" == "qa" || "$ENV" == "prod" ]]; then
          stop_env "$ENV"
        else
          stopped=0
          for e in dev qa prod; do
            if [ -f ".pid.$e" ]; then
              stop_env "$e"
              stopped=1
            fi
          done
          if [ $stopped -eq 1 ]; then
            echo "Ambientes locales de Phantom detenidos con éxito."
          fi
        fi
        ;;
      restart)
        if [[ "$ENV" == "dev" || "$ENV" == "qa" || "$ENV" == "prod" ]]; then
          echo "Reiniciando Phantom en entorno [$ENV]..."
          stop_env "$ENV" 2>/dev/null || true
          start_env "$ENV"
        else
          restarted=0
          for e in dev qa prod; do
            if [ -f ".pid.$e" ]; then
              echo "Reiniciando Phantom en entorno [$e]..."
              stop_env "$e" 2>/dev/null || true
              start_env "$e"
              restarted=1
            fi
          done
          if [ $restarted -eq 0 ]; then
            echo "No hay ambientes locales corriendo para reiniciar."
          fi
        fi
        ;;
      status)
        for e in dev qa prod; do
          status_env "$e"
          echo ""
        done
        ;;
      dev)
        run_dev "${ARGS[@]+"${ARGS[@]}"}"
        ;;
      prod)
        run_prod "${ARGS[@]+"${ARGS[@]}"}"
        ;;
      install)
        run_install "${ARGS[@]+"${ARGS[@]}"}"
        ;;
      uninstall)
        run_uninstall "${ARGS[@]+"${ARGS[@]}"}"
        ;;
      clean)
        run_clean "${ARGS[@]+"${ARGS[@]}"}"
        ;;
      debug)
        run_debug "${ARGS[@]+"${ARGS[@]}"}"
        ;;
      sbom)
        run_sbom "${ARGS[@]+"${ARGS[@]}"}"
        ;;
      passwd)
        run_change "${ARGS[@]+"${ARGS[@]}"}"
        ;;
      catalog-export)
        run_catalog_export "${ARGS[@]+"${ARGS[@]}"}"
        ;;
      catalog-import)
        run_catalog_import "${ARGS[@]+"${ARGS[@]}"}"
        ;;
      *)
        echo "Subcomando local desconocido: ${SUB_CMD:-}" >&2
        echo "Usa: ./phantom local help" >&2
        exit 1
        ;;
    esac
    ;;

  docker)
    case "${SUB_CMD:-}" in
      build)
        run_build "${ARGS[@]+"${ARGS[@]}"}"
        ;;
      start|up)
        phantom_require_compose
        phantom_compose up -d
        phantom_print_urls
        ;;
      stop|down)
        phantom_require_compose
        phantom_compose down
        echo "[+] Servicios de Docker detenidos."
        ;;
      restart)
        phantom_require_compose
        phantom_compose restart "${ARGS[@]+"${ARGS[@]}"}"
        ;;
      status|ps)
        phantom_require_compose
        phantom_compose ps
        ;;
      logs)
        run_logs "${ARGS[@]+"${ARGS[@]}"}"
        ;;
      fix)
        run_fix_docker "${ARGS[@]+"${ARGS[@]}"}"
        ;;
      *)
        echo "Subcomando docker desconocido: ${SUB_CMD:-}" >&2
        echo "Usa: ./phantom docker help" >&2
        exit 1
        ;;
    esac
    ;;

  cluster)
    case "${SUB_CMD:-}" in
      deploy)
        run_k8s "${ARGS[@]+"${ARGS[@]}"}"
        ;;
      destroy)
        echo "[*] Destruyendo despliegue de Kubernetes..."
        if command -v kubectl &>/dev/null; then
          kubectl delete -f deploy/kubernetes/base/deployment.yaml || true
        else
          echo "[!] kubectl no está disponible." >&2
          exit 1
        fi
        ;;
      *)
        echo "Subcomando cluster desconocido: ${SUB_CMD:-}" >&2
        echo "Usa: ./phantom cluster help" >&2
        exit 1
        ;;
    esac
    ;;

  doctor)
    run_doctor
    ;;

  docs)
    case "${SUB_CMD:-}" in
      generate)
        run_docs_generate
        ;;
      serve)
        run_docs_serve
        ;;
      *)
        echo "Subcomando docs desconocido: ${SUB_CMD:-}" >&2
        echo "Usa: ./phantom docs help" >&2
        exit 1
        ;;
    esac
    ;;

  plugin)
    case "${SUB_CMD:-}" in
      list)
        run_plugin_list
        ;;
      install)
        run_plugin_install "${ARGS[@]+"${ARGS[@]}"}"
        ;;
      *)
        echo "Subcomando plugin desconocido: ${SUB_CMD:-}" >&2
        echo "Usa: ./phantom plugin help" >&2
        exit 1
        ;;
    esac
    ;;

  backup)
    run_backup "${ARGS[@]+"${ARGS[@]}"}"
    ;;

  restore)
    run_restore "${ARGS[@]+"${ARGS[@]}"}"
    ;;

  migrate)
    run_db_migrate "${ARGS[@]+"${ARGS[@]}"}"
    ;;

  release)
    run_release "${ARGS[@]+"${ARGS[@]}"}"
    ;;

  update)
    run_update "${ARGS[@]+"${ARGS[@]}"}"
    ;;

  version)
    run_version
    ;;

  help)
    run_help
    ;;

  *)
    echo "Namespace o comando desconocido: $NAMESPACE" >&2
    echo "Usa: ./phantom help" >&2
    exit 1
    ;;
esac
