  export NEXT_DEBUG=true
  run_dev "$@"
}

run_sbom() {
  if ! command -v syft &>/dev/null; then
    echo "[!] syft no está instalado. Instálalo desde: https://github.com/anchore/syft"
    exit 1
  fi
  mkdir -p storage/sbom
  echo "[*] Generando SBOM..."
  syft dir:. -o json > storage/sbom/sbom.json
  echo "[+] SBOM generado en storage/sbom/sbom.json"
}

run_fix_docker() {
  if [[ ! -f "docker-compose.yml" ]]; then
    echo "[!] Ejecuta desde la raíz del repo Phantom."
    exit 1
  fi

  local ip port sans
  ip=$(hostname -I 2>/dev/null | awk '{print $1}' || echo "127.0.0.1")
  port=$(grep -E '^PHANTOM_HTTP_PORT=' .env 2>/dev/null | cut -d= -f2 || echo 3000)
  port=${port:-3000}
  sans="localhost,127.0.0.1,${ip}"

  if [[ -f .env ]]; then
    if grep -qE '^PHANTOM_TLS_SANS=' .env; then
      sed -i "s/^PHANTOM_TLS_SANS=.*/PHANTOM_TLS_SANS=${sans}/" .env 2>/dev/null || \
      sed -i "" "s/^PHANTOM_TLS_SANS=.*/PHANTOM_TLS_SANS=${sans}/" .env
    else
      echo "PHANTOM_TLS_SANS=${sans}" >> .env
    fi
  else
    echo "[!] No hay .env — copia .env.example primero."
    exit 1
  fi

  echo "[+] PHANTOM_TLS_SANS=${sans}"

  if command -v ufw &>/dev/null && ufw status 2>/dev/null | grep -qi 'Status: active'; then
    ufw allow "${port}/tcp" comment 'Phantom SecOps web' || true
    echo "[+] ufw: allow ${port}/tcp"
  fi

  if [[ "$(sysctl -n vm.overcommit_memory 2>/dev/null || echo 0)" != "1" ]]; then
    echo "[*] Redis recomienda vm.overcommit_memory=1 (opcional)"
    sudo sysctl -w vm.overcommit_memory=1 2>/dev/null || true
  fi

  echo "[*] Recreando contenedor web…"
  phantom_require_compose
  phantom_compose up -d --build web

  echo "[*] Esperando HTTPS…"
  local ok=0
  local i
  for i in $(seq 1 20); do
    if curl -kfsS "https://127.0.0.1:${port}/" -o /dev/null 2>/dev/null; then
      ok=1
      break
    fi
    sleep 2
  done

  echo ""
  if [[ "$ok" -eq 1 ]]; then
    echo "[+] Phantom responde en https://127.0.0.1:${port}"
    echo "    Desde tu PC (misma red): https://${ip}:${port}"
  else
    echo "[!] Sigue sin responder. Revisa: ./phantom docker logs web"
  fi
}

# Helper functions for new subcommands
run_doctor() {
  echo "============================================================"
  echo " Phantom Doctor — Diagnósticos de Entorno"
  echo "============================================================"
  
  local error_count=0
  
  # 1. Verificar variables de entorno (.env)
  echo "[*] Verificando variables de entorno (.env)..."
  if ! run_verify_env; then
    ((error_count++))
  fi
  
  # 2. Verificar dependencias de host
  echo ""
  echo "[*] Verificando dependencias del sistema..."
  if command -v python3 &>/dev/null; then
    echo "    OK   — Python3: $(python3 --version)"
  else
    echo "    FAIL — Python3 no instalado"
    ((error_count++))
  fi
  
  if command -v node &>/dev/null; then
    echo "    OK   — Node.js: $(node --version)"
  else
    echo "    FAIL — Node.js no instalado"
    ((error_count++))
  fi
  
  if command -v npm &>/dev/null; then
    echo "    OK   — npm: $(npm --version)"
  else
    echo "    FAIL — npm no instalado"
    ((error_count++))
  fi

  if command -v docker &>/dev/null; then
    echo "    OK   — Docker: $(docker --version)"
    if docker info &>/dev/null; then
      echo "    OK   — Docker Daemon está corriendo"
    else
      echo "    WARN — Docker Daemon no está corriendo"
    fi
  else
    echo "    WARN — Docker no instalado"
  fi

  if command -v mkcert &>/dev/null; then
    echo "    OK   — mkcert instalado"
  else
    echo "    WARN — mkcert no instalado (HTTPS local requerirá certificados manuales)"
  fi
  
  # 3. Verificar puertos ocupados (3000, 8000)
  echo ""
  echo "[*] Verificando ocupación de puertos..."
  for port in 3000 8000; do
    local pids
    pids=$(pids_on_port "$port")
    if [[ -n "$pids" ]]; then
      echo "    WARN — Puerto $port ocupado por PIDs: $pids"
      for pid in $pids; do
        echo "           -> $(describe_pid "$pid")"
      done
    else
      echo "    OK   — Puerto $port está libre"
    fi
  done
  
  # 4. Verificar certificados TLS locales
  echo ""
  echo "[*] Verificando certificados TLS..."
  if [[ -f certificates/localhost.pem && -f certificates/localhost-key.pem ]]; then
    echo "    OK   — Certificados locales HTTPS presentes en certificates/"
  else
    echo "    WARN — Falta certificados HTTPS en certificates/"
  fi

  echo ""
  if [[ $error_count -eq 0 ]]; then
    echo "[+] Doctor: Todo se ve en orden. ¡Listo para operar!"
    return 0
  else
    echo "[!] Doctor: Se detectaron $error_count problema(s). Revisa las advertencias anteriores."
    return 1
  fi
}

run_docs_generate() {
  echo "============================================================"
  echo " Phantom Docs — Generando índice de documentación"
  echo "============================================================"
  
  local index_file="docs/README.md"
  mkdir -p docs
  
  cat <<'EOF' > "$index_file"
# Documentación Operativa y de Arquitectura de Phantom

Bienvenido al portal de documentación de la plataforma Phantom SecOps. Esta documentación está organizada por categorías y sirve como fuente de verdad para el desarrollo y la operación.

## Índice de Documentos

EOF

  # Recorrer subdirectorios de docs y añadir archivos md
  # Evitamos index.html, README.md, _sidebar.md
  local dir category files
  for dir in docs/*; do
    if [[ -d "$dir" ]]; then
      category=$(basename "$dir")
      # Capitalize category name
      category="$(echo "${category:0:1}" | tr '[:lower:]' '[:upper:]')${category:1}"
      
      # Check if there are markdown files in the folder
      files=$(find "$dir" -maxdepth 1 -name "*.md" | sort 2>/dev/null)
      if [[ -n "$files" ]]; then
        echo "### $category" >> "$index_file"
        echo "" >> "$index_file"
        while IFS= read -r f; do
          [[ -n "$f" ]] || continue
          local title filename rel_path cat_lower
          filename=$(basename "$f")
          cat_lower=$(echo "$category" | tr '[:upper:]' '[:lower:]')
          rel_path="${cat_lower}/${filename}"
          # Extract first header as title, otherwise use filename
          title=$(grep -m 1 "^# " "$f" | sed 's/^# //' || echo "")
          if [[ -z "$title" ]]; then
            title="${filename%.md}"
          fi
          echo "- [$title]($rel_path)" >> "$index_file"
        done <<< "$files"
        echo "" >> "$index_file"
      fi
    fi
  done
  
  echo "[+] Índice de documentación generado en: $index_file"
}

