#!/usr/bin/env bash
# Phantom — CLI operativo (punto de entrada único).
# Uso: ./phantom <comando> [opciones]
#      ./phantom help
set -euo pipefail

OPS_DIR="$(cd "$(dirname "$0")" && pwd)"
PHANTOM_ROOT="$(cd "$OPS_DIR/.." && pwd)"
export PHANTOM_ROOT

CMD="${1:-help}"
shift || true

run() {
  local script="$1"
  shift || true
  exec "$OPS_DIR/$script" "$@"
}

case "$CMD" in
  help|-h|--help|"")
    cat <<EOF
Phantom — operaciones

  Ambientes de Desarrollo & Producción
    dev              HTTPS + hot-reload
    dev debug        Dev con diagnóstico de puertos
    dev passwd       Cambiar contraseña admin (interactivo sin eco)
    dev stop         Detener servicios de desarrollo
    dev logs         Logs del entorno dev
    prod             Producción nativa / Docker
    prod debug       Diagnóstico en entorno prod
    prod passwd      Cambiar contraseña admin (interactivo sin eco)
    prod stop        Detener servicios prod

  Docker (servidor)
    install          Preparar .env y build imágenes
    install --docker Instalar Docker Desktop en macOS + build imágenes
    install --system Instalar Docker en Ubuntu (sudo)
    start            Levantar stack Docker
    stop             Detener stack (conserva datos)
    restart [svc]    Reiniciar contenedores
    update           git pull + build + recreate (alias: deploy)
    build            Solo construir imágenes
    logs [svc]       Ver logs (default: api + web; --all para todo)
    health           Comprobar web y API
    backup [dir]     Respaldo BD + storage
    verify-env       Validar .env
    clean            Limpiar artefactos locales
    uninstall        Desinstalar (ver --help)

  Base de datos / Credenciales / Catálogo
    passwd           Cambiar credenciales admin (alias: change, password)
    catalog-export   Exportar catálogo → backend/catalog/
    catalog-import   Importar catálogo empaquetado

  Compliance / Supply Chain / Diagnóstico
    sbom             Generar SBOM (Syft) + escaneo Grype → storage/sbom/
    debug            Dev con diagnóstico de puertos
    fix-docker       Cert TLS + firewall (scripts/fix-docker-access.sh)

Ejemplos:
  ./phantom dev
  ./phantom dev debug
  ./phantom dev passwd          # Solicitud doble sin eco en terminal
  ./phantom dev passwd --force  # Omitir complejidad estricta en dev
  ./phantom prod
  ./phantom passwd
  ./phantom install && ./phantom start
  ./phantom backup /var/backups

Scripts individuales en: ops/
EOF
    ;;
  dev|start-dev)
    if [[ $# -gt 0 ]]; then
      SUBCMD="$1"
      shift
      case "$SUBCMD" in
        debug) run debug.sh "$@" ;;
        passwd|password|change|change-password) run change.sh "$@" ;;
        stop) run stop.sh "$@" ;;
        logs) run logs.sh "$@" ;;
        health|status) run healthcheck.sh "$@" ;;
        *) run dev.sh "$SUBCMD" "$@" ;;
      esac
    else
      run dev.sh "$@"
    fi
    ;;
  prod|start-prod)
    if [[ $# -gt 0 ]]; then
      SUBCMD="$1"
      shift
      case "$SUBCMD" in
        debug) run debug.sh "$@" ;;
        passwd|password|change|change-password) run change.sh "$@" ;;
        stop) run stop.sh "$@" ;;
        logs) run logs.sh "$@" ;;
        health|status) run healthcheck.sh "$@" ;;
        *) run prod.sh "$SUBCMD" "$@" ;;
      esac
    else
      run prod.sh "$@"
    fi
    ;;
  passwd|password|change|change-password|credentials) run change.sh "$@" ;;
  install) run install.sh "$@" ;;
  uninstall) run uninstall.sh "$@" ;;
  start) run start.sh "$@" ;;
  stop) run stop.sh "$@" ;;
  restart) run restart.sh "$@" ;;
  update|deploy) run update.sh "$@" ;;
  build) run build.sh "$@" ;;
  logs) run logs.sh "$@" ;;
  health|healthcheck) run healthcheck.sh "$@" ;;
  backup|db-backup) run backup.sh "$@" ;;
  verify-env|env|verify) run verify-env.sh "$@" ;;
  clean) run clean.sh "$@" ;;
  catalog-export) run catalog-export.sh "$@" ;;
  catalog-import|db-catalog) run catalog-import.sh "$@" ;;
  sbom|supply-chain) run sbom.sh "$@" ;;
  native) run native.sh "$@" ;;
  debug) run debug.sh "$@" ;;
  fix-docker) exec "$PHANTOM_ROOT/scripts/fix-docker-access.sh" "$@" ;;
  *)
    echo "[!] Comando desconocido: $CMD" >&2
    echo "    Usa: ./phantom help" >&2
    exit 1
    ;;
esac
